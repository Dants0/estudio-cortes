# --- Claude (sua assinatura Pro/Max, sem créditos de API) ---
# No terminal: claude setup-token  -> aprove no navegador e cole o token aqui.
# Não defina ANTHROPIC_API_KEY junto: ela teria prioridade sobre o token.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-opus-5-5

# --- ElevenLabs (opcional aqui: também dá para colar pelo painel) ---
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
TTS_MAX_CHARS=2500

# --- Ponte do Windows: PhotoCraft (thumbnails) e FilmCraft (edição automática) — ponte\iniciar-ponte.bat ---
# Qualquer texto longo e aleatório; o painel e a ponte usam o mesmo valor.
PONTE_TOKEN=
PHOTOCRAFT_CLI=D:\PhotoCraft\PhotoCraft\photocraft-cli.exe
FILMCRAFT_CLI=D:\FilmCraft\FilmCraft\filmcraft-cli.exe

# --- Pastas do Windows montadas no container ---
VIDEOS_HOST_DIR=D:/Videos
GOOGLE_CLIENT_SECRET_HOST=D:/Pipeline/secrets/client_secret.json

# Núcleos usados na renderização (vazio = automático)
RENDER_CONCURRENCY=


# --- Banco (Postgres do docker-compose) ---
# Qualquer senha longa; o container do painel monta a URL sozinho com o host "banco".
POSTGRES_PASSWORD=
# Para rodar o servidor fora do Docker (npm run dev:server, npm run db:studio): porta 5433 no localhost
DATABASE_URL=postgresql://mesa:SUA_SENHA@localhost:5433/mesa_de_corte

# --- Google Drive (envio dos vídeos editados; usa o mesmo client_secret.json do YouTube) ---
# Conta sugerida no login do Google
DRIVE_EMAIL=

# --- Opcionais: só para rodar fora do Docker (o docker-compose já define estes) ---
# HOST=0.0.0.0
# PORT=3100
# PUBLIC_URL=http://localhost:3100
# VIDEOS_DIR=D:/Videos
# YOUTUBE_CLIENT_SECRET=D:/Pipeline/secrets/client_secret.json
# PONTE_URL=http://localhost:3101
# PONTE_PORT=3101
# DATA_DIR=./data
# CONFIG_DIR=./config
# RENDER_TIMEOUT_MS=300000
# LOG_LEVEL=info
